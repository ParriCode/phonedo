# Plantilla de configuración. Cópiala a secrets.properties (ignorado por git)
# y rellénala; sin ese archivo la compilación se para y explica qué falta.

# Identificador del Reader en /metadata y en el sobre de cada evento.
READER_ID=reader-wearos-01
# Puerto del servidor HTTP del reloj.
READER_PORT=8080
# Vacío: el servidor no pide token. Si no, exige "Authorization: Bearer <token>".
READER_TOKEN=

# URLs de los Managers separadas por comas; vacío = no se envía a ningún Manager.
# Ejemplo: http://192.168.1.10:3003,http://192.168.1.11:3003
MANAGER_URLS=
# Va en el campo "token" del cuerpo de /newEvent (API_TOKEN_MANAGER del Manager).
MANAGER_TOKEN=
