@startuml phonendo
!theme plain
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 13
skinparam packageStyle rectangle
title Phonendo — services, proof and payment on Stellar

package "Phonendo (off-chain, private readings)" {
  component "Reader\n(simulated, ESP32, C++)" as R
  component Manager as M
  component "Verifier\n(ed25519 key)" as V
  database "Storage\n(LevelDB)" as S
  component "Publisher\n(Groth16 prover)" as P
}

package "Stellar testnet (public)" {
  component "Soroban contract\nadherence" as C #E8E6FF
  component "USDC token" as T #E8E6FF
}

actor "Patient / carrier" as U
component "Web panels\n(React)" as W

R --> M : readings over SSE\n(Manager subscribes)\nor HTTP /newEvent
M --> V : HTTP /verify\nCaptured event + hash
V --> M : Verified event\nsigned with ed25519
M --> S : store Verified events\n(HTTP or SSE)
M --> P : Verified stream (SSE)\nPublisher subscribes
P --> M : POST /signBatch (event ids only)\nreply: commitment + signature
M --> V : POST /signBatch\nreply: commitment + signature
P --> C : claim(patient, session,\ncommitment, signature, proof)
C --> T : transfer payout
T --> U : USDC
C ..> W : SessionPaid events\n(read from the RPC)

note bottom of V
  Computes the commitment from the readings
  it verified itself, never from the caller.
  Signs commitment || sessionId ||
  patient key || verifierId.
end note

note bottom of C
  claim() checks: session not paid before,
  Verifier signature (host ed25519),
  Groth16 proof (BLS12-381) against the
  policy stored on-chain. Then pays.
  One contract per use case:
  rehabilitation and cold chain.
end note

legend bottom
  Arrow: direction of the data. Only the commitment, public
  parameters, session id, result and payment reach Stellar.
  Readings never leave Phonendo.
endlegend
@enduml
